# Exemplo de configuração. Copie para .env e preencha. NÃO comite o .env real.
#   cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────
# Gere uma chave: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.seudominio.com

# ── Banco de dados ──────────────────────────────────────────────────
# Dev usa SQLite por padrão. Para Postgres, descomente:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/anaplan

# ── Marca do produto ────────────────────────────────────────────────
PRODUCT_NAME=Integrador de Planejamento

# ── Integração Anaplan (mono-tenant; vira cofre por tenant na Fase 1) ─
ANAPLAN_EMAIL=
ANAPLAN_PASSWORD=
ANAPLAN_IMPORT_DIR=./import_files

# ── E-mail (notificações de carga) ──────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=anaplan@example.com
# Lista separada por vírgulas: fulano@empresa.com,ciclano@empresa.com
ANAPLAN_NOTIFY_RECIPIENTS=
